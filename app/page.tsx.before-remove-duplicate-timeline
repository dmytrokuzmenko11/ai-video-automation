                        </div>
                      ) : (
                        <div className="flex-1 min-h-[320px] rounded-md border border-dashed border-slate-700/80 bg-slate-900/40" />
                      )}
                    </div>
                  </div>

                {activeVersion && (
                  <div className="relative rounded-lg border border-zinc-800 bg-zinc-950/80 p-3">
                    <span className="pointer-events-none absolute left-2 top-1 z-30 rounded bg-zinc-950/90 px-1 text-[9px] leading-none text-zinc-500">
                      TIMELINE PANEL
                    </span>
                    <div className="flex items-center justify-between mb-2">
                      <div>
                        <h4 className="text-sm font-medium uppercase tracking-[0.18em] text-zinc-400">
                          V{activeVersion.version_number} — Монтажний таймлайн
                        </h4>

                        <p className="text-xs text-slate-500 mt-1">
                          Перетягуй сцени для зміни порядку
                        </p>
                      </div>

                      <div className="flex items-center gap-3">
                        <span className="text-xs text-slate-400">
                          {savingScenes ? "Збереження..." : "Збережено"}
                        </span>

                      </div>
                    </div>

                        <div className="relative flex w-full gap-1 rounded-md border border-zinc-800 bg-zinc-900/60 p-1">
                        <span className="pointer-events-none absolute left-2 top-1 z-30 rounded bg-zinc-950/90 px-1 text-[9px] leading-none text-zinc-500">
                          SCENE STRIP
                        </span>
                      {activeVersion.scenes.map(
                        (scene, index) => {
                          const total =
                            selectedTask.duration || 1;

                          const width =
                            (scene.duration / total) * 100;

                          const sceneRenderStart =
                            activeVersion.scenes
                              .slice(0, index)
                              .reduce(
                                (sum, currentScene) =>
                                  sum + currentScene.duration,
                                0
                              );

                          const sceneRenderEnd =
                            sceneRenderStart + scene.duration;

                          let sceneProgress = 0;

                          if (renderPlaybackTime >= sceneRenderEnd) {
                            sceneProgress = 1;
                          } else if (
                            renderPlaybackTime > sceneRenderStart
                          ) {
                            sceneProgress =
                              (renderPlaybackTime -
                                sceneRenderStart) /
                              scene.duration;
                          }

                          return (
                            <div
                              key={`${activeVersion.id}-${index}-${scene.start}-${scene.end}`}
                              data-scene-index={index}
                              draggable
                              onDragStart={() =>
                                setDraggedSceneIndex(index)
                              }
                              onDragOver={(e) =>
                                e.preventDefault()
                              }
                              onDrop={() =>
                                handleDragEnd(index)
                              }
                              onDragEnd={() =>
                                setDraggedSceneIndex(null)
                              }
                              className={`relative rounded border overflow-hidden shrink-0 cursor-grab active:cursor-grabbing transition ${
                                draggedSceneIndex === index
                                  ? "border-emerald-500/40 bg-emerald-500/15 text-emerald-200"
                                  : "border-zinc-800 bg-zinc-900/80 text-zinc-300 hover:border-zinc-700 hover:bg-zinc-800"
                              }`}
                              style={{
                                flexGrow: Math.max(width, 1),
                                flexShrink: 1,
                                flexBasis: 0,
                                minWidth: 0,
                              }}
                            >
                              <div className="relative flex items-stretch min-w-0 bg-slate-700">
                                <span className="pointer-events-none absolute left-2 top-1 z-30 rounded bg-zinc-950/90 px-1 text-[9px] leading-none text-zinc-500">
                                  RENDER SCENE ITEM WRAPPER
                                </span>
                                <div
                                  className="absolute inset-y-0 left-0 pointer-events-none z-10 transition-[width] duration-100"
                                  style={{
                                    width: `${sceneProgress * 100}%`,
                                  }}
                                />
                                {selectedTask.video_url && (
                                  <SceneThumbnail
                                    videoUrl={
                                      selectedTask.video_url
                                    }
                                    timestamp={scene.start}
                                  />
                                )}

                                <div className="absolute top-2 left-2 z-20 rounded-md bg-slate-950/70 px-2 py-1 text-[11px] font-medium text-white shadow-sm backdrop-blur-sm">
                                  <span className="pointer-events-none absolute left-0 top-[-0.75rem] z-30 rounded bg-zinc-950/90 px-1 text-[9px] leading-none text-zinc-500">
                                    RENDER SCENE DURATION BADGE
                                  </span>
                                  {scene.duration.toFixed(1)}s
                                </div>
                              </div>
                            </div>
                          );
                        }
                      )}
                    </div>

                    {activeVersion.render_url && (
                          <div className="relative mt-6 mb-6">
                          <span className="pointer-events-none absolute left-2 top-1 z-30 rounded bg-zinc-950/90 px-1 text-[9px] leading-none text-zinc-500">
                            RENDER PREVIEW WRAPPER
                          </span>
                          <span className="pointer-events-none absolute left-2 top-1 z-30 rounded bg-zinc-950/90 px-1 text-[9px] leading-none text-zinc-500">
                            RENDER PREVIEW
                          </span>
                          <p className="mb-2 text-sm font-medium text-emerald-400">
                          Готовий рендер V{activeVersion.version_number}:
                        </p>

                          <video
                          ref={renderVideoRef}
                          controls={false}
                          src={activeVersion.render_url}
                          playsInline
                          preload="metadata"
                          onPlay={() => setIsRenderPlaying(true)}
                          onPause={() => setIsRenderPlaying(false)}
                          onError={(event) => {
                            const target = event.currentTarget;
                            console.error(
                              "Render video error:",
                              target.currentSrc || target.src,
                              target.error
                            );
                          }}
                            className="max-h-96 w-full rounded-md border border-zinc-800"
                        />

                        <div className="mt-3 flex justify-center">
                          <button
                            type="button"
                            onClick={handleDownloadRender}
                            className="inline-flex items-center gap-2 rounded-md border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-300 hover:bg-emerald-500/20 hover:text-emerald-200"
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 20 20"
                              fill="currentColor"
                              className="h-4 w-4"
                              aria-hidden="true"
                            >
                              <path d="M10 2a.75.75 0 0 1 .75.75v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V2.75A.75.75 0 0 1 10 2Zm-5.25 12a.75.75 0 0 1 .75.75v1a.75.75 0 0 0 .75.75h8.5a.75.75 0 0 0 .75-.75v-1a.75.75 0 0 1 1.5 0v1A2.25 2.25 0 0 1 14.75 18h-8.5A2.25 2.25 0 0 1 4 15.75v-1a.75.75 0 0 1 .75-.75Z" />
                            </svg>
                            Завантажити відео
                          </button>
                        </div>
                      </div>
                    )}

                    <div className="flex justify-between text-xs text-slate-500">
                      <span>00:00</span>
                      <span>
                        {formatTime(selectedTask.duration || 0)}
                      </span>
                    </div>
                  </div>
                )}
              </>
            ) : (
              <div className="mb-4">
                <label className="mb-2 block text-sm font-medium text-zinc-300">
                  Завантажити відео (.mp4):
                </label>

                <input
                  type="file"
                  accept="video/*"
                  onChange={handleVideoUpload}
                  disabled={uploading}
                  className="block w-full cursor-pointer text-sm text-zinc-300 file:mr-4 file:rounded-md file:border-0 file:bg-zinc-800 file:px-4 file:py-2 file:text-zinc-100 hover:file:bg-zinc-700"
                />
              </div>
            )}

            {uploadStatus && (
              <p
                className={`mb-4 mt-4 text-sm font-medium ${
                  uploading ? "text-amber-400" : "text-emerald-400"
                }`}
              >
                {uploadStatus}
              </p>
            )}

            <div className="flex justify-center mt-4">
              <button
                type="button"
                onClick={() => deleteTask(selectedTask.id)}
                className="inline-flex items-center gap-2 rounded-md border border-zinc-800 bg-zinc-900/80 px-4 py-2 text-sm font-medium text-zinc-300 transition hover:border-red-500/30 hover:bg-red-500/10 hover:text-red-300"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="2"
                  className="w-5 h-5"
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    d="M3 6h18"
                  />
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    d="M8 6V4h8v2"
                  />
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    d="M19 6l-1 14H6L5 6"
                  />
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    d="M10 10v6M14 10v6"
                  />
                </svg>
                Видалити задачу
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
